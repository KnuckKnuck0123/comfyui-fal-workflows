# Copy this file to `.env` and fill in real values.
# The runner reads these from the process environment; it does NOT auto-load .env.
# Set them in your shell profile or via `setx` on Windows, or export before running.

# Required for any workflow with auth: "fal" in fal_models.json
FAL_KEY=your-fal-key-here

# Required for render_nanobanana_gemini, refine_nanobanana_chain, refine_from_output
GEMINI_API_KEY=your-gemini-key-here
