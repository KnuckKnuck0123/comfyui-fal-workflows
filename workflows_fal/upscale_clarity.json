{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "PARAM_IMAGE" },
    "_meta": { "title": "Load Image to Upscale" }
  },
  "2": {
    "class_type": "Upscaler_fal",
    "inputs": {
      "image": ["1", 0],
      "upscale_factor": 2.0,
      "negative_prompt": "blurry, low quality, jpeg artifacts, oversharpened, plastic, waxy, deformed, watermark, text",
      "creativity": 0.2,
      "resemblance": 0.75,
      "guidance_scale": 3.5,
      "num_inference_steps": 20,
      "enable_safety_checker": true,
      "seed": -1
    },
    "_meta": { "title": "Clarity Upscaler (Fal) - tuned for cleaner output" }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "upscale_clarity",
      "images": ["2", 0]
    },
    "_meta": { "title": "Save Image" }
  }
}
