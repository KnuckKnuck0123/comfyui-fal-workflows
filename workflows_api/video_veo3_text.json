{
  "1": {
    "class_type": "Veo3_fal",
    "inputs": {
      "prompt": "PARAM_PROMPT",
      "aspect_ratio": "16:9",
      "duration": "8s",
      "negative_prompt": "",
      "enhance_prompt": true,
      "seed": -1,
      "generate_audio": true
    },
    "_meta": { "title": "Google Veo3 Text-to-Video" }
  },
  "2": {
    "class_type": "SaveStringKJ",
    "inputs": {
      "string": ["1", 0],
      "filename_prefix": "video_veo3_t2v",
      "output_folder": "output",
      "file_extension": ".txt"
    },
    "_meta": { "title": "Save Veo3 Video URL" }
  },
  "3": {
    "class_type": "LoadVideoURL",
    "inputs": {
      "url": ["1", 0],
      "force_rate": 0,
      "force_size": "Disabled",
      "custom_width": 512,
      "custom_height": 512,
      "frame_load_cap": 30,
      "skip_first_frames": 0,
      "select_every_nth": 6
    },
    "_meta": { "title": "Decode Veo3 video for preview (8s clip)" }
  },
  "4": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": ["3", 0]
    },
    "_meta": { "title": "Video Preview" }
  }
}
