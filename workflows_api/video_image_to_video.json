{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "PARAM_IMAGE" },
    "_meta": { "title": "Load Source Image" }
  },
  "2": {
    "class_type": "SeedanceImageToVideo_fal",
    "inputs": {
      "prompt": "PARAM_PROMPT",
      "image": ["1", 0],
      "resolution": "720p",
      "duration": "5",
      "camera_fixed": false,
      "seed": -1
    },
    "_meta": { "title": "Seedance Image-to-Video" }
  },
  "3": {
    "class_type": "SaveStringKJ",
    "inputs": {
      "string": ["2", 0],
      "filename_prefix": "video_seedance_i2v",
      "output_folder": "output",
      "file_extension": ".txt"
    },
    "_meta": { "title": "Save Video URL" }
  },
  "4": {
    "class_type": "LoadVideoURL",
    "inputs": {
      "url": ["2", 0],
      "force_rate": 0,
      "force_size": "Disabled",
      "custom_width": 512,
      "custom_height": 512,
      "frame_load_cap": 30,
      "skip_first_frames": 0,
      "select_every_nth": 4
    },
    "_meta": { "title": "Decode video for preview" }
  },
  "5": {
    "class_type": "PreviewImage",
    "inputs": {
      "images": ["4", 0]
    },
    "_meta": { "title": "Video Preview" }
  }
}
